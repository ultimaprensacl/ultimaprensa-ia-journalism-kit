# ====================================================================
# Última Prensa - Variables de Entorno y Claves de API
# ====================================================================
# Copiar este archivo a .env y completar con las credenciales requeridas.
# comando: cp .env.example .env

# Clave de la API oficial de la Real Academia Española (https://rae-api.com)
RAE_API_KEY=tu_clave_de_api_rae_aqui

# Ticket de la API de Mercado Público (ChileCompra)
# https://api.mercadopublico.cl
MERCADOPUBLICO_TICKET=tu_ticket_de_chilecompra_aqui

# Configuración de Substack (opcional para publicación directa)
SUBSTACK_PUBLICATION=ultimaprensacl
SUBSTACK_SID_COOKIE=
